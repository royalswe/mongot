{
	"name": "snake",
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"dev": "vite dev",
		"start:dev": "nodemon",
		"build": "vite build",
		"stage": "mkdir -p ../../../mongot_prod/snake.mongot.com && rm -rf ../../../mongot_prod/snake.mongot.com/client && cp -R build ../../../mongot_prod/snake.mongot.com/client",
		"build-stage": "vite build && npm run stage",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "playwright test --project=chromium"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"@typescript-eslint/eslint-plugin": "^8.71.2",
		"@typescript-eslint/parser": "^8.71.2",
		"autoprefixer": "^10.6.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"postcss": "^8.5.30",
		"postcss-load-config": "^6.0.1",
		"postcss-preset-env": "^11.6.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"svelte-preprocess": "^6.0.5",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vite-plugin-mkcert": "^2.1.0"
	}
}
