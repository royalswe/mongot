:root {
	--game-ink: #0a1512;
	--game-raised: #10251f;
	--game-panel: #142b23;
	--game-line: #354f43;
	--game-paper: #f4f3e9;
	--game-muted: #adc0b5;
	--game-lime: #a8f36b;
	--game-mint: #59e5a3;
	--game-coral: #ff8e78;
	--game-amber: #ffc46b;
}

.game-shell {
	display: flex;
	width: 100%;
	height: 100dvh;
	min-height: 520px;
	flex-direction: column;
	overflow: hidden;
	background: var(--game-ink);
	color: var(--game-paper);
}

.game-topbar {
	position: relative;
	z-index: 2;
	display: flex;
	min-height: 4.5rem;
	align-items: center;
	justify-content: space-between;
	gap: 1rem;
	padding: 0.6rem clamp(0.75rem, 2vw, 1.5rem);
	border-bottom: 2px solid var(--game-line);
	background: var(--game-raised);
	box-shadow: 0 4px 0 #050b09;
}

.game-brand {
	display: inline-flex;
	min-width: 0;
	align-items: center;
	gap: 0.75rem;
	color: var(--game-paper);
	text-decoration: none;
}

.brand-icon {
	display: grid;
	width: 2.6rem;
	height: 2.6rem;
	flex: 0 0 auto;
	place-items: center;
	border: 2px solid var(--game-ink);
	background: var(--game-lime);
	box-shadow: 3px 3px 0 var(--game-mint);
	color: var(--game-ink);
	font-size: 1.1rem;
}

.game-brand-copy {
	display: grid;
	min-width: 0;
	gap: 0.15rem;
}

.game-brand-copy strong {
	overflow: hidden;
	font-size: 1rem;
	font-weight: 1000;
	letter-spacing: 0;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.game-brand-copy small {
	color: var(--game-mint);
	font-size: 0.6rem;
	font-weight: 900;
	letter-spacing: 0.14em;
}

.game-state-strip {
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
	gap: 0.45rem;
}

.state-chip {
	display: inline-flex;
	min-height: 2.25rem;
	align-items: center;
	gap: 0.45rem;
	padding: 0.4rem 0.65rem;
	border: 1px solid var(--game-line);
	background: var(--game-ink);
	color: var(--game-muted);
	font-size: 0.73rem;
	font-weight: 900;
}

.state-chip i {
	color: var(--game-amber);
}

.state-chip.live i {
	color: var(--game-mint);
}

.player-chip i {
	color: var(--game-lime);
}

.back-to-lobby {
	display: inline-flex;
	min-height: 2.65rem;
	flex: 0 0 auto;
	align-items: center;
	gap: 0.55rem;
	padding: 0.45rem 0.75rem;
	border: 1px solid var(--game-line);
	color: var(--game-paper);
	font-size: 0.8rem;
	font-weight: 900;
	text-decoration: none;
	transition:
		background-color 140ms ease,
		color 140ms ease;
}

.back-to-lobby:hover {
	background: var(--game-ink);
	color: var(--game-lime);
}

.game-workspace {
	display: grid;
	min-height: 0;
	flex: 1 1 auto;
	grid-template-columns: minmax(0, 1fr) minmax(300px, 350px);
	gap: clamp(0.75rem, 1.5vw, 1.25rem);
	padding: clamp(0.75rem, 1.5vw, 1.25rem);
}

.play-area {
	display: flex;
	min-width: 0;
	min-height: 0;
	flex-direction: column;
}

.board-heading {
	display: flex;
	align-items: end;
	justify-content: space-between;
	gap: 1rem;
	margin-bottom: 0.75rem;
}

.section-kicker {
	margin: 0 0 0.3rem;
	color: var(--game-mint);
	font-size: 0.65rem;
	font-weight: 900;
	letter-spacing: 0.14em;
	text-transform: uppercase;
}

.board-heading h1 {
	margin: 0;
	color: var(--game-paper);
	font-size: 0.8rem;
	font-weight: 900;
	letter-spacing: 0;
}

.board-hint {
	display: flex;
	align-items: center;
	gap: 0.45rem;
	margin: 0;
	color: var(--game-muted);
	font-size: 0.75rem;
}

.board-hint i {
	color: var(--game-lime);
}

.board-frame {
	display: flex;
	min-width: 0;
	min-height: 0;
	flex: 1 1 auto;
	align-items: stretch;
	justify-content: center;
	padding: clamp(0.5rem, 1.4vw, 1rem);
	border: 2px solid var(--game-ink);
	background: var(--game-raised);
	box-shadow: 5px 5px 0 #050b09;
}

.board-frame .snake-layout {
	width: 100%;
	height: 100%;
}

.board-footnote {
	display: flex;
	align-items: flex-start;
	gap: 0.5rem;
	margin: 0.75rem 0 0;
	color: var(--game-muted);
	font-size: 0.72rem;
	line-height: 1.5;
}

.board-footnote i {
	margin-top: 0.1rem;
	color: var(--game-amber);
}

.result-card {
	display: flex;
	align-items: center;
	gap: 1rem;
	margin-bottom: 1rem;
	padding: 0.9rem 1rem;
	border: 2px solid var(--game-ink);
	background: #203c30;
	box-shadow: 4px 4px 0 var(--game-lime);
}

.result-icon {
	display: grid;
	width: 2.7rem;
	height: 2.7rem;
	flex: 0 0 auto;
	place-items: center;
	border: 2px solid var(--game-ink);
	background: var(--game-lime);
	color: var(--game-ink);
	font-size: 1.1rem;
}

.result-copy {
	min-width: 0;
	flex: 1;
}

.result-copy h1 {
	margin: 0;
	color: var(--game-paper);
	font-size: 1.15rem;
	font-weight: 1000;
	letter-spacing: 0;
	overflow-wrap: anywhere;
}

.result-copy p:last-child {
	margin: 0.2rem 0 0;
	color: #c1d3c7;
	font-size: 0.8rem;
	line-height: 1.4;
}

.result-action {
	display: inline-flex;
	min-height: 2.7rem;
	flex: 0 0 auto;
	align-items: center;
	justify-content: center;
	gap: 0.5rem;
	padding: 0.55rem 0.75rem;
	border: 2px solid var(--game-ink);
	background: var(--game-lime);
	box-shadow: 3px 3px 0 var(--game-mint);
	color: var(--game-ink);
	font-size: 0.78rem;
	font-weight: 900;
	text-decoration: none;
	cursor: pointer;
}

.result-action:hover {
	background: #c0ff8d;
}

.game-sidebar {
	display: flex;
	min-width: 0;
	min-height: 0;
	flex-direction: column;
	gap: 0.75rem;
	overflow: hidden;
}

.sidebar-tabs {
	display: none;
}

.sidebar-panel {
	min-width: 0;
	border: 2px solid var(--game-ink);
	background: var(--game-raised);
	box-shadow: 4px 4px 0 #050b09;
}

.player-panel {
	max-height: 58%;
	overflow-y: auto;
	padding: 1rem;
	scrollbar-color: var(--game-line) var(--game-raised);
}

.game-chat-panel {
	display: flex;
	min-height: 0;
	flex: 1 1 auto;
	flex-direction: column;
	padding: 1rem;
}

.panel-heading {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 0.75rem;
	margin-bottom: 0.75rem;
}

.panel-heading h2 {
	margin: 0;
	color: var(--game-paper);
	font-size: 1.1rem;
	font-weight: 1000;
	letter-spacing: 0;
}

.panel-heading h2 i {
	margin-right: 0.35rem;
	color: var(--game-lime);
}

.chat-live {
	display: inline-flex;
	align-items: center;
	gap: 0.4rem;
	color: var(--game-mint);
	font-size: 0.65rem;
	font-weight: 900;
	text-transform: uppercase;
}

.status-dot {
	width: 0.45rem;
	height: 0.45rem;
	border-radius: 50%;
	background: var(--game-mint);
}

.chat-sender {
	color: var(--game-lime);
	font-weight: 900;
}

.game-chat-panel .chat-messages {
	flex: 1 1 auto;
}

.game-chat-panel .chat-history {
	min-height: 6rem;
}

.sidebar-tabs button:focus-visible {
	outline: 3px solid var(--game-lime);
	outline-offset: 3px;
}

@media (max-width: 900px) {
	.game-shell {
		height: auto;
		min-height: 100dvh;
		overflow: visible;
	}

	.game-topbar {
		min-height: 4rem;
	}

	.game-workspace {
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: minmax(0, 1fr) auto;
	}

	.play-area {
		min-height: min(70svh, 46rem);
	}

	.game-sidebar {
		display: block;
		overflow: visible;
	}

	.sidebar-tabs {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem;
		margin-bottom: 0.65rem;
	}

	.sidebar-tabs button {
		min-height: 2.8rem;
		border: 1px solid var(--game-line);
		background: var(--game-raised);
		color: var(--game-muted);
		font-size: 0.8rem;
		font-weight: 900;
	}

	.sidebar-tabs button.active {
		border: 2px solid var(--game-ink);
		background: var(--game-lime);
		box-shadow: 3px 3px 0 var(--game-mint);
		color: var(--game-ink);
	}

	.player-panel {
		max-height: initial;
		overflow: visible;
	}

	.game-chat-panel {
		min-height: 18rem;
	}

	.board-frame {
		min-height: 14rem;
	}
}

@media (max-width: 560px) {
	.game-topbar {
		flex-wrap: wrap;
		gap: 0.55rem;
		padding: 0.6rem 0.75rem;
	}

	.game-brand {
		margin-right: auto;
	}

	.game-state-strip {
		order: 3;
		width: 100%;
		justify-content: flex-start;
	}

	.state-chip {
		min-height: 2rem;
		font-size: 0.68rem;
	}

	.back-to-lobby {
		min-height: 2.4rem;
		padding: 0.4rem 0.6rem;
	}

	.game-workspace {
		gap: 0.9rem;
		padding: 0.75rem 0.65rem 1.25rem;
	}

	.play-area {
		min-height: 62svh;
	}

	.board-heading {
		align-items: flex-start;
		flex-direction: column;
		gap: 0.4rem;
	}

	.board-hint {
		font-size: 0.68rem;
	}

	.board-frame {
		min-height: 12rem;
		padding: 0.35rem;
		box-shadow: 3px 3px 0 #050b09;
	}

	.board-footnote {
		font-size: 0.67rem;
	}

	.result-card {
		flex-wrap: wrap;
		gap: 0.7rem;
		padding: 0.7rem;
	}

	.result-copy {
		width: calc(100% - 3.5rem);
		flex: initial;
	}

	.result-copy h1 {
		font-size: 1rem;
	}

	.result-copy p:last-child {
		font-size: 0.73rem;
	}

	.result-action {
		width: 100%;
	}
}

@media (max-height: 620px) and (min-width: 901px) {
	.game-topbar {
		min-height: 3.7rem;
	}

	.game-workspace {
		padding: 0.6rem;
	}

	.player-panel,
	.game-chat-panel {
		padding: 0.7rem;
	}
}

@media (prefers-reduced-motion: reduce) {
	.back-to-lobby {
		transition: none;
	}
}
