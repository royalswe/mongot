{
  "name": "snake-server",
  "version": "0.0.1",
  "config": {
    "cookie": "s3cr3t"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "node scripts/ensure-dev-certificate.mjs",
    "start": "ALIEN_UWS=1 node dist/app.js",
    "build": "rimraf ./dist && tsc -p tsconfig.prod.json",
    "test:load": "node scripts/load-test.mjs",
    "stage": "mkdir -p ../../../mongot_prod/snake.mongot.com && rm -rf ../../../mongot_prod/snake.mongot.com/server && cp -R dist ../../../mongot_prod/snake.mongot.com/server && rm -rf ../../../mongot_prod/snake.mongot.com/server/models",
    "build-stage": "npm run build && npm run stage",
    "dev": "ALIEN_UWS=1 COOKIE_SECRET=$npm_package_config_cookie NODE_ENV=development ts-node-dev --inspect --respawn --ignore-watch src/snakeChat.json src/app.ts",
    "dev:con": "nodemon --exec ts-node src/app.ts",
    "test1": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --runInBand",
    "preview": "NODE_ENV=development NODE_OPTIONS='--inspect' node dist/app.js"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/client-sessions": "^0.8.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/uws": "^0.13.7",
    "jest": "^30.5.2",
    "node-dev": "^8.0.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "client-sessions": "^0.8.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.71.0"
  }
}
