extends base
block head
  - var title = 'Login'

block body
  main
    form(method="post")
      .form-block
        h1 Login
        

        input(type="hidden", name="_csrf", value=csrfToken)
        label(for='email') Email or username
        input#email.icon-user(type="text", name="email", required=true, autocomplete="username", autofocus)
        label(for='password') Password
        input#password.icon-lock(type="password", name="password", required=true, autocomplete="current-password")
        a.forgot-link(href='/forgot') Forgot password?
        input(type="submit" id="login" value="Login")

        p.form-links New here? <a href="/register">Create an account</a>
