extends base
block head
  - var title = 'Mongot'
  link(rel='stylesheet', type='text/css', href='/css/home.css?v=3.0')

block body
  section.hero
    h1.hero-title mongot.com
    p.hero-tagline Bringing back the game nostalgia from blip.se.
    .hero-actions
      a.btn.btn-play-game(href='#games') Play a game
      unless user
        a.btn(href='/register') Create account

  main.landing
    section#games
      h2.section-title Games
      .games
        a.game.card(href='https://general.mongot.com')
          img(src='/img/general.jpg', alt='General')
          .game-body
            p.game-tag Strategy · Turn based
            h3 General
            p A clone of the RISK-like strategy game from Blip. Conquer territories from your opponents and control the entire map.
            span.game-play Play General &rarr;
        a.game.card(href='https://blockwars.mongot.com')
          img(src='/img/blockwars.jpg', alt='Blockwars')
          .game-body
            p.game-tag Puzzle · Multiplayer
            h3 Blockwars
            p A multiplayer tetris-inspired game similar to TetriNET. Clear lines, collect specials and use them to attack your opponents.
            span.game-play Play Blockwars &rarr;
        a.game.card(href='https://snake.mongot.com/')
          img(src='/img/snake.jpg', alt='Snake')
          .game-body
            p.game-tag Arcade · Multiplayer
            h3 Snake
            p A multiplayer snake game for up to four players. Grow every step, box in your rivals and be the last snake standing.
            span.game-play Play Snake &rarr;

    section.story
      .card
        h2 One account, every game
        p Register once and use the same login on every game.
        p Guests can play unranked; log in to earn a rank on the high score lists.
      .card
        h2 About mongot
        p Blip.se was a site where you could play games, chat with friends and compete in tournaments. It was created in 2003 and closed at the end of 2010.
        p The purpose of mongot.com is to recreate games from Blip.se over time, with modern technology and some changes along the way. General came first in 2016, Blockwars followed in 2017 after requests from users.
        p Snake is the latest game to be released, launched in 2026.
