extends base
block head
  - var title = 'Reset password'
block body
  main
    form(method="post")
      .form-block
        h1 Reset Password
        p.lead Choose a new password for your account.
        p#register_error #{error}
        input(type="hidden", name="_csrf", value=csrfToken)
        label(for='new-password') New password
        input#new-password.password.icon-lock(type="password", name="password", required=true, minlength="4", autocomplete="new-password", autofocus)
        label(for='confirm-password') Confirm password
        input#confirm-password.password.icon-lock(type="password", name="confirmpassword", required=true, autocomplete="new-password")
        input(type="submit" id="reset" value="Update Password")

  script.
    document.getElementById('reset').onclick = function () {
      var password = document.getElementsByName("password")[0].value;
      var confirmPassword = document.getElementsByName("confirmpassword")[0].value;
      var error = '';

      if (password !== confirmPassword) {
        error += "password doesn't match. </br>";
      }
      if (error !== '') {
        document.getElementById("register_error").innerHTML = error;
        return false;
      }
    };