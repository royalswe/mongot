extends base
block head
  - var title = 'Register'
  
block body

  main
    form(method="post")
      .form-block
        h1 Register
        p.lead Create one account for every mongot game.
        p#register_error #{error}

        input(type="hidden", name="_csrf", value=csrfToken)
        input#g-recaptcha-response(type="hidden", name="g-recaptcha-response")
        input(type="hidden", name="action", value=validate_captcha)
        label(for='username') Username
        input#username.icon-user(type='text', name="username", required=true, maxlength="16", minlength="2", autocomplete="username", autofocus, value=username)
        p.hint 2-16 characters: letters, numbers, underscore and hyphen.

        label(for='email') Email (optional)
        input#email.icon-mail(type="email", name="email", autocomplete="email", value=email)
        p.hint Needed to save your progress and to reset a forgotten password.

        label(for='password') Password
        input#password.icon-lock(type="password", name="password", minlength="4", required=true, autocomplete="new-password")
        label(for='password-confirm') Confirm password
        input#password-confirm.icon-lock(type="password", name="confirmpassword", required=true, autocomplete="new-password")
        input(type="submit" id="register" value="Register")

        div#result
        div.flash-message.info We only use your email to activate your account and reset a forgotten password. We will never share or spam it.

        p.form-links Already have an account? <a href="/login">Login</a>

  script(src='https://www.google.com/recaptcha/api.js?render=6LfhkTkdAAAAAKFz0uyxngYmmrMQeIYuspM610it')
  script.
    grecaptcha.ready(function() {
        grecaptcha.execute('6LfhkTkdAAAAAKFz0uyxngYmmrMQeIYuspM610it', {action:'validate_captcha'})
                  .then(function(token) {
            // add token value to form
            document.getElementById('g-recaptcha-response').value = token;
        });
    });

  script.
    var password = document.getElementsByName("password")[0];
    var confirmPassword = document.getElementsByName("confirmpassword")[0];
    var email = document.getElementsByName("email")[0];
    var username = document.getElementsByName("username")[0];

  
    //- var email_toggle = document.getElementsByName("email_toggle")[0];

    //- email_toggle.addEventListener('change', e => {
    //-     if(!e.target.checked){
    //-       email.disabled = true;
    //-       email.hidden = true;
    //-     }
    //-     else{
    //-       email.disabled = false;
    //-       email.hidden = false;
    //-     }
    //- });


    document.getElementById('register').onclick = function () {
      var error = '';

      if (password.value !== confirmPassword.value) {
        error += "password doesn't match. </br>";
      }
      if(email.value && !email.value.match(/\S+@\S+\.\S+/)) {
        error += "Email is not valid. </br>";
      }
      if (username.value.length < 2 || username.value.length > 16) {
        error += "Username must be between 2 and 16 characters long.  </br>";
      }
      if (username.value && !username.value.match(/^[a-zA-Z0-9-_]+$/i)) {
        error += "Username can only contain letters, numbers, underscore and hyphen.  </br>";
      }
      if (error !== '') {
        document.getElementById("register_error").innerHTML = error;
        return false;
      }
    };

