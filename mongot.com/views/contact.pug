extends base
block head
  - var title = 'Contact'

block body
  main#rules
    .form-block
      h1 Contact
      p.lead Feel free to contact us if you have any suggestions to make the site better.
      form(method="post")
        input(type="hidden", name="_csrf", value=csrfToken)
        label(for='email') Email (optional)
        input#email.icon-mail(type='text', name="from", autocomplete="email")
        textarea.no-type(name="content", value='write here')
        label(for='textarea') Message
        textarea#textarea(cols='40', rows='5', name="text", required=true)
        input.no-type(type='checkbox', name="agreement")
        input(type="submit" id="send_email" value="Send message")
