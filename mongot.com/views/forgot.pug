extends base
block head
  - var title = 'Forgot password'

block body
  main
    form(method="post")
      .form-block
        h1 Forgot Password
        p.lead Enter your email address and we'll send you a recovery link.

        input(type="hidden", name="_csrf", value=csrfToken)
        label(for='email') Email
        input#email.icon-mail(type="email", name="email", required=true, autocomplete="email", autofocus)
        input(type="submit" id="login" value="Send recovery email")

        p.form-links <a href="/login">Back to login</a>
