extends base
block head
  - var title = 'General'

block styles
  link(rel='stylesheet', type='text/css', href='/css/home.css?v=2.0')

block body
  main.landing
    section.hero
      div
        p.kicker Realtime strategy · 2–4 players
        h1.hero-title General
        p.hero-tagline Conquer the world in a realtime Risk-like strategy game. Pick a colour, deploy your armies and roll for glory.
        .hero-actions
          a.btn.btn-primary(href='/lobby') Play now
          a.btn(href='/rules') How to play
      .hero-board
        img(src='/img/game/maps/world.svg', alt='The World game board with its six continents')
        span.sticker Now with bots

    section.features
      a.feature.card(href='/lobby')
        img(src='/img/game/icons/battle.svg', alt='')
        h2 Lobby
        p Join an open table or start one with bots. Guests play unranked; log in to earn rank.
      a.feature.card(href='/highscore')
        img(src='/img/game/icons/game-over.svg', alt='')
        h2 High Score
        p See the top 30 generals and where you stand.
      a.feature.card(href='/rules')
        img(src='/img/game/icons/dice.svg', alt='')
        h2 How to play
        p First time playing? Learn the phases, missions and how the dice decide a battle.