extends base
block head
  - const title = 'General Lobby'
  link(rel='manifest', href='/manifest.webmanifest')
  link(rel='apple-touch-icon', href='/img/pacghost-meta.png')

block styles
  link(rel='stylesheet', type='text/css', href='/css/lobby.css?v=2.2')

block body
  if user && user.god
    #admin_panel(hidden)
      select(id='kick_out_room')
        option(value='', disabled='disabled', selected='selected') Choose room
      select(id='kick_out_player')
        option(value='', disabled='disabled', selected='selected') Player
      input#kick_out_btn(type="button", value="Kick Out Player")
    button.admin-toggle God Mode
  main#lobby_page
    section#lobby
      h1.page-title General Lobby
      #allrooms
        table
          thead
            tr
              th
                | Game Name
              th
                | Players
              th
                | Map
              th
                | Status
              th
                | Join
          tbody

      #news_box
        p.news-heading Game under construction
        p.news-text The game is currently in beta. Expect unfinished features and changes while we continue building.
        p.news-heading Help us grow
        a.facebook-link(href='https://www.facebook.com/blipmini/', target='_blank', rel='noopener noreferrer') Visit us on Facebook

      section#lobby_notifications
        h2.notification-heading Lobby alerts
        p.notification-intro Know when someone arrives, even with no Lobby tab open.
        .notification-control
          input#toggle_notification(type='checkbox', aria-label='Notify me when someone arrives in the Lobby', aria-describedby='notification-status', onchange='NOTIFICATION.toggleNotificationPermissions(this);')
          label(for='toggle_notification')
            span.notification-bell(aria-hidden='true')
            span.notification-control-copy
              strong Arrival notifications
              span This browser only
            span#notification-state.notification-state Off
        p#notification-status.notification-status(role='status', aria-live='polite') Notifications are off for this browser.
        details#notification-details
          summary#notification-help-toggle How it works &amp; limits
          #notification-help
            p.notification-help-lead A heads-up, not a guarantee
            ul
              li
                strong Browser permission.
                |  A supported browser, and permission to send notifications.
              li
                strong iPhone or iPad.
                |  On iOS/iPadOS 16.4 or newer, add General to your Home Screen and enable notifications from there.
              li
                strong Delivery limits.
                |  Quitting the browser, power saving, offline mode, or Do Not Disturb may delay or block alerts.
              li
                strong No arrival spam.
                |  At most one alert per minute. Undelivered pushes expire at the push service after one minute.
              li
                strong Your choice.
                |  Settings apply to this browser/device. Turn the bell off to stop alerts; clearing site data or revoking permission may require enabling them again.
            button.notification-help-close(type='button', onclick='NOTIFICATION.closeHelp();') Close explanation

    section#lobby_chat
      div#messages
      div#chat_input
        //input#message(type="text", autocomplete="off", placeholder='#{(user) ? "Enter your message here" : "Login to use the chat"}')
        input#message(type="text", autocomplete="off", placeholder="Enter your message here")
        input#send(type='submit', value='Send')
    section#users_online

  script
    if user
      | window.user = !{JSON.stringify(user)}
    else
      | window.user = 'guest';
  script(src='/socket.io/socket.io.js')
  script(src='/resources/howler.min.js')
  if useBundles
    script(src='/js/lobby.min.js?v=2.1')
  else
    script(src='/js/notifications.js')
    script(src='/js/storage.js')
    script(src='/js/ranks.js')
    script(src='/js/lobby.js')
    script(src='/js/lobby.chat.js')
