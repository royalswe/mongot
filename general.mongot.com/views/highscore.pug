extends base
block head
  - var title = 'High score'

block body
  main.site-page
    h1.page-title High Score
    p.page-lead The top 30 generals, ranked by rating.
    .card.table-card
      table.data-table
        thead
          tr
            th No
            th General
            th Rating
            th Won / Lost
        tbody
          - for (var i=0; i<highscores.length; i++)
            tr
              td
                span.rank #{i+1}
              td
                a(href='https://mongot.com/user/' + highscores[i].username ) #{highscores[i].username}
              td
                img(src="/img/rankings/" + rankIcon(highscores[i].points_general) alt='')
                | #{highscores[i].points_general}
              td
                | #{highscores[i].games_won_general} / #{highscores[i].games_lost_general}


