              stop(offset='0%', stop-color='#7c4b9e')
            radialgradient#radial_black
              stop(offset='0%', stop-color='#3b3632')

          text.player-round(x='903', y='29') Round
          circle#user_color(cx='958', cy='20', r='14')
          text#username_turn.player-round(x='980', y='29')

        img(class="dice-log" src="/img/game/icons/dice.svg" title="start dice log" alt="dice log")
        img(class="surrender-flag" src="/img/game/icons/flag.svg" title="surrender" alt="surrender")
        button#start_bots(type='button' style='display:none') Start with bots
    script
      if user
        | var user = !{JSON.stringify(user)}
      else
        | var user = 'guest';
    script(src='/socket.io/socket.io.js')
    script(src='/resources/jquery.min.js')
    script(src='/resources/howler.min.js')

    if useBundles
      script(src='/js/compress.js?v=2.0')
    else
      script(src='/js/storage.js')
      script(src='/js/ranks.js')
      script(src='/js/chat.js')
      script(src='/js/game.room.js')
      script(src='/js/map.js')
      script(src='/js/battle.and.movement.js')


