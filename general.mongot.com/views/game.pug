doctype html
html
  head
    title General
    link(rel='shortcut icon', href='img/favicon.ico', type='image/x-icon')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(rel='preload', href='/fonts/BarlowCondensed-700.woff2', as='font', type='font/woff2', crossorigin)
    link(rel='stylesheet', type='text/css', href='/css/retro.css?v=1.0')
    link(rel='stylesheet', type='text/css', href='/css/game.board.css?v=2.0')

    section#chatroom
      ul#player_list

      div#messages
      input#message(type='text', autocomplete="off", placeholder='Enter your message here')
      img#send(src='/img/game/icons/send.svg' alt="send chat message")

    section#game_board
      div#game_header
        img#phase_img(src='/img/game/icons/waiting.svg' alt='')
        div#header_buttons
          button#next_turn Next turn
          button#show_gold Show gold
          button#mission Show mission
        div#game_info
          p.phase-message Waiting for players
          p.phase-info #{!user ? "Choose a color to join. Guests play unranked." : (user.active ? "The game starts when all players have joined." : "Choose a color to join. Verify your email to earn rank.")}
        div#stats
          p.user-gold Gold: 0
          p.user-goldIncome Income: 0
          p#match_rank
          label(for='countdown') &#128337;
          span#countdown

      .svg-container
        img.slide-toggle(src='/img/game/icons/chat-toggle.svg', alt="hide and show chat")
        svg.svg-content(version='2.0', viewbox='0 0 1147.148 859.25')
