doctype html
html
  head
    title General
    link(rel='shortcut icon', href='img/favicon.ico', type='image/x-icon')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    link(rel='preload', href='/fonts/BarlowCondensed-700.woff2', as='font', type='font/woff2', crossorigin)
    link(rel='stylesheet', type='text/css', href='/css/retro.css?v=1.0')
    link(rel='stylesheet', type='text/css', href='/css/game.board.css?v=2.8')

  body
    section#chatroom
      .chat-content
        ul#player_list
        div.sidebar-tabs(role='tablist' aria-label='Sidebar views')
          button#show_chat.sidebar-tab(type='button' role='tab' aria-selected='true' aria-controls='chat-panel' tabindex='0') Chat
          button#show_activity.sidebar-tab(type='button' role='tab' aria-selected='false' aria-controls='activity-panel' aria-label='Activity' aria-keyshortcuts='A' title='Activity (A)' tabindex='-1') Activity
        div#chat-panel.sidebar-panel.chat-panel.is-active(role='tabpanel' aria-labelledby='show_chat')
          div#messages
          .chat-composer
            input#message(type='text' autocomplete="off" placeholder='Chat (/)' aria-label='Chat message' aria-keyshortcuts='/')
            button#send(type='button' aria-label='Send chat message' title='Send chat message')
              img(src='/img/game/icons/send.svg' alt='')
        div#activity-panel.sidebar-panel.activity-panel(role='tabpanel' aria-labelledby='show_activity' aria-hidden='true')
          label.activity-autoscroll
            input#activity_autoscroll(type='checkbox' checked aria-controls='game_actions')
            span Auto-scroll
          ol#game_actions(role='log' aria-label='Game activity' aria-live='polite' aria-relevant='additions')
            li.activity-empty No actions recorded yet
      button.slide-toggle(type='button', aria-label='Toggle chat', aria-controls='chatroom', aria-expanded='true', title='Toggle chat')
        img(src='/img/game/icons/chat-toggle.svg' alt='')

    section#game_board
      header#game_header
        img#phase_img(src='/img/game/icons/waiting.svg' alt='')
        div#header_buttons
          button#next_turn(type='button' aria-keyshortcuts='N' title='Next turn (N)') Next turn
          button#show_gold(type='button' aria-keyshortcuts='G' title='Show gold (G)') Show gold
          button#mission(type='button' aria-keyshortcuts='M' title='Show mission (M)') Show mission
        div#game_info
          div.phase-message Waiting for players
          div.phase-info #{!user ? "Choose a color to join. Guests play unranked." : (user.active ? "The game starts when all players have joined." : "Choose a color to join. Verify your email to earn rank.")}
        div#stats
          p.user-gold Gold: 0
          p.user-goldIncome Income: 0
          p#match_rank
          p.turn-timer
            span(aria-hidden='true') &#128337;
            span#countdown(role='timer' aria-label='Time remaining')

      .svg-container
        svg.svg-content(version='2.0', viewbox='0 0 1147.148 859.25')
          defs
            radialgradient#radial_blue
              stop(offset='0%', stop-color='#2d5fa8')
            radialgradient#radial_red
              stop(offset='0%', stop-color='#d33a2c')
            radialgradient#radial_orange
              stop(offset='0%', stop-color='#ee9a1c')
            radialgradient#radial_green
              stop(offset='0%', stop-color='#3e8b3c')
            radialgradient#radial_purple
              stop(offset='0%', stop-color='#7c4b9e')
            radialgradient#radial_black
              stop(offset='0%', stop-color='#3b3632')

          text.player-round(x='903', y='29') Round
          circle#user_color(cx='958', cy='20', r='14')
          text#username_turn.player-round(x='980', y='29')

        button#toggle_map_controls.game-action-button(type='button' aria-label='Hide map controls' title='Hide map controls' aria-expanded='true' aria-controls='map_dice_log toggle_game_sound surrender_game toggle_unit_layout')
          svg(aria-hidden='true' focusable='false')
            use(href='/img/game/icons/options.sprite.svg?v=4#controls-collapse')
        button#map_dice_log.dice-log.game-action-button(type='button' aria-label='Open dice log' title='Open dice log')
          svg(aria-hidden='true' focusable='false')
            use(href='/img/game/icons/options.sprite.svg?v=1#dice')
        button#toggle_game_sound.game-action-button.game-sound-toggle(type='button' aria-pressed='false' aria-label='Mute game sounds' title='Mute game sounds')
          svg(aria-hidden='true' focusable='false')
            use#game_sound_icon(href='/img/game/icons/options.sprite.svg?v=1#sound-on')
        button#surrender_game.surrender-flag.game-action-button(type='button' aria-label='Give up' title='Give up')
          svg(aria-hidden='true' focusable='false')
            use(href='/img/game/icons/options.sprite.svg?v=1#flag')
        button#toggle_unit_layout.unit-layout-toggle.game-action-button(type='button' aria-label='Switch to mobile unit controls' title='Switch to mobile unit controls' aria-pressed='false')
          svg(aria-hidden='true' focusable='false')
            use(href='/img/game/icons/options.sprite.svg?v=3#unit-desktop')
        button#start_bots(type='button' style='display:none') Start with bots
    script
      if user
        | window.user = !{JSON.stringify(user)}
      else
        | window.user = 'guest';
    script(src='/socket.io/socket.io.js')
    script(src='/resources/howler.min.js')

    if useBundles
      script(src='/js/compress.js?v=2.5')
    else
      script(src='/js/storage.js')
      script(src='/js/ranks.js')
      script(src='/js/chat.js')
      script(src='/js/game.room.js')
      script(src='/js/map.js')
      script(src='/js/battle.and.movement.js')


