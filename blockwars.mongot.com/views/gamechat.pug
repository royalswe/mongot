extends base
block head
  - const title = 'Game chat'

block pageStyles
  link(rel='stylesheet', href='/css/pages.css?v=4')

block body
  main.page-shell.chat-archive
    header.page-heading
      p.page-kicker Room history
      h1 Game chat
      p.page-intro Messages are grouped by room. Names and messages are displayed as text.
    section#chatroom(aria-label='Archived room messages')
      div#messages(role='log', aria-live='off')

  script.
    const messages = !{JSON.stringify(messages).replace(/</g, '\\u003c')};
    const messageList = document.getElementById('messages');
    const userColors = new Map();
    let currentRoom = null;

    if (messages.length === 0) {
      const emptyState = document.createElement('p');
      emptyState.className = 'empty-state';
      emptyState.textContent = 'No archived messages yet.';
      messageList.append(emptyState);
    }

    for (const { room, username, message } of messages) {
      if (room !== currentRoom) {
        currentRoom = room;
        const heading = document.createElement('h2');
        heading.textContent = room;
        messageList.append(heading);
      }

      if (!userColors.has(username)) {
        const color = (Math.random() * 0x1000000 | 0).toString(16).padStart(6, '0');
        userColors.set(username, `#${color}`);
      }

      const row = document.createElement('div');
      const name = document.createElement('span');
      name.style.color = userColors.get(username);
      name.textContent = `${username}:`;
      row.append(name, document.createTextNode(` ${message}`));
      messageList.append(row);
    }
