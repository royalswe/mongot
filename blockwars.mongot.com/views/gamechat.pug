extends base
block head
  - const title = 'Game chat'
  style.
    section#chatroom {
      height: 100%;
      width: 100%;
    }
    #messages {
      padding: 7px;
      border: 5px ridge #B5B4B4;
      background-color: #000;
      color: #fff;
      font-size: 11px
    }
    h2{ text-align: center; }
    #messages div { margin-bottom: 5px }
    #messages .name-red {  color: #e01313  }
    #messages .name-blue {  color: #3d94f6  }
    #messages .name-orange {  color: orange  }
    #messages .name-green {  color: #05d005  }
    #messages .name-purple {  color: #ce04ce  }
    #messages .name-black {  color: #9C9C9C  }

block body

  section#chatroom
    div#messages

  script.
    const messages = !{JSON.stringify(messages).replace(/</g, '\\u003c')};
    const messageList = document.getElementById('messages');
    const userColors = new Map();
    let currentRoom = null;

    for (const { room, username, message } of messages) {
      if (room !== currentRoom) {
        currentRoom = room;
        const heading = document.createElement('h2');
        heading.textContent = room;
        messageList.append(heading);
      }

      if (!userColors.has(username)) {
        const color = (Math.random() * 0x1000000 | 0).toString(16).padStart(6, '0');
        userColors.set(username, `#${color}`);
      }

      const row = document.createElement('div');
      const name = document.createElement('span');
      name.style.color = userColors.get(username);
      name.textContent = `${username}:`;
      row.append(name, document.createTextNode(` ${message}`));
      messageList.append(row);
    }
