extends base
block head
  - const title = 'Blockwars Lobby'
  link(rel='manifest', href='/manifest.webmanifest')
  link(rel='apple-touch-icon', href='/img/pacghost-meta.png')

block body
  section#lobby
    header.lobby-heading
      p.lobby-eyebrow Multiplayer Tetris
      h1 Blockwar Lobby
      p.lobby-intro Find an open room and jump into a match, or watch a game already in progress.
    #allrooms
      h2.lobby-section-heading Public rooms
      table
        caption.visually-hidden Available public Blockwars rooms
        thead
          tr
            th
              | Game Name
            th(title='Seated players/players in room')
              | Players
            th
              | Status
            th(title='Ranked games are only for registered players')
              | Ranking
            th
              | Join
        tbody

    #news_box
      h2.news-heading Blockwars online Tetris!
      p.news-text
      | It is possible to play without login but you won't be able to play in ranked rooms and gain points.
      | Remember to look at the&nbsp;
      a(href="/rules") how to play
      |  section for game instruction. Check out&nbsp;
      a(href="//docs.google.com/document/d/1sgS65SjF9h6Gpkhc5LqfL1bEemNMtN4iGt9C5IwXNvY", target='_blank') this
      |  document if you have any feedback or bug to report.
      p 
        | Type 
        mark Add bot
        |  in game chat to play with bots.
      p
        | Type 
        mark Lose bots
        |  and bots will surrender.

      p.news-heading Help us grow
      .fb-like(data-href='https://www.facebook.com/blipmini/', data-layout='button_count', data-action='like', data-size='large', data-show-faces='false', data-share='true')

    #lobby_notifications
      h2.notification-heading Lobby alerts
      p.notification-intro Know when someone arrives, even with no Lobby tab open.
      .notification-control
        input#toggle_notification(type='checkbox', aria-label='Notify me when someone arrives in the Lobby', aria-describedby='notification-status', onchange='NOTIFICATION.toggleNotificationPermissions(this);')
        label(for='toggle_notification')
          span.notification-bell(aria-hidden='true')
            i.fa.fa-bell-o
          span.notification-control-copy
            strong Arrival notifications
            span This browser only
          span#notification-state.notification-state Off
      p#notification-status.notification-status(role='status', aria-live='polite') Notifications are off for this browser.
      details#notification-details
        summary#notification-help-toggle How it works &amp; limits
        #notification-help
          p.notification-help-lead A heads-up, not a guarantee
          ul
            li
              strong Browser permission.
              |  A supported browser, and permission to send notifications.
            li
              strong iPhone or iPad.
              |  On iOS/iPadOS 16.4 or newer, add Blockwars to your Home Screen and enable notifications from there.
            li
              strong Delivery limits.
              |  Quitting the browser, power saving, offline mode, or Do Not Disturb may delay or block alerts.
            li
              strong No arrival spam.
              |  At most one alert per minute. Undelivered pushes expire at the push service after one minute.
            li
              strong Your choice.
              |  Settings apply to this browser/device. Turn the bell off to stop alerts; clearing site data or revoking permission may require enabling them again.
          button.notification-help-close(type='button', onclick='NOTIFICATION.closeHelp();') Close explanation

    section#lobby_chat
      h2.lobby-section-heading Lobby chat
      div#messages
      div#chat_input
        //input#message(type='text', autocomplete="off", placeholder='#{(user) ? "Enter your message here" : "Login to use the chat"}')
        input#message(type="text", autocomplete="off", placeholder="Enter your message here")
        input#send(type='submit', value='Send')
    section#users_online
  script
    if user
      | var user = !{JSON.stringify(user)}
    else
      | var user = 'guest';
  script(src='/resources/howler.min.js')

  //- script(src='/js/lobby.min.js')

  script(src='/js/modules/utils.js')
  script(src='/js/modules/notifications.js')
  script(src='/js/lobby.js')
  
  script.
    document.addEventListener("DOMContentLoaded", function(event) { 
      (function (d, s, id) {
          const fjs = d.getElementsByTagName(s)[0];
          if (d.getElementById(id)) return;
          const js = d.createElement(s);
          js.id = id;
          js.src = "//connect.facebook.net/en_US/sdk.js#xfbml=1&version=v2.8&appId=396659270516324";
          fjs.parentNode.insertBefore(js, fjs);
      }(document, 'script', 'facebook-jssdk'));
    });