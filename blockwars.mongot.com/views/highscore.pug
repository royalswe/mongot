extends base
block head
  - const title = 'High score'
  style.
    body {
      background-color: #E0E0E0;
    }
    .costum-table-dark .table th {
      padding: 15px 10px !important;
      background-color: #212121;
      color: #EC7149;
      border-top: 0 !important;
      border-bottom: 2px solid #505050 !important;
    }
    .costum-table-dark .table tr:hover {
      background-color: #3A3A3A;
    }
    .costum-table-dark {
      background: #434242;
      color: #FFF;
      width: 90%;
      margin-left: auto;
      margin-right: auto;
      margin-bottom: 20px;
    }
    tr:nth-child(even) {
      background: #666666;
    }
    td{
      padding-left: 5px;
    }
    td a{
      color: #ffffff;
      text-decoration: none;
    }
    th {
      border-top: 1px solid #505050;
      text-align: left;
      cursor: ns-resize;
    }
    .table-sort-button {
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      text-align: left;
      cursor: pointer;
    }
    th[aria-sort="ascending"] .table-sort-button::after {
      content: " \\25B2";
    }
    th[aria-sort="descending"] .table-sort-button::after {
      content: " \\25BC";
    }
    h1{
      text-align: center;
      padding: 10px;
      text-shadow: 0 1px 0 #ccc,
      0 2px 0 #c9c9c9,
      0 3px 0 #bbb,
      0 4px 0 #b9b9b9,
      0 5px 0 #aaa,
      0 6px 1px rgba(0, 0, 0, .1),
      0 0 5px rgba(0, 0, 0, .1),
      0 1px 3px rgba(0, 0, 0, .3),
      0 3px 5px rgba(0, 0, 0, .2),
      0 5px 10px rgba(0, 0, 0, .25),
      0 10px 10px rgba(0, 0, 0, .2),
      0 20px 20px rgba(0, 0, 0, .15);
      color: #656565;
      font-size: 35px;
    }
    h2{
      text-align: center;
    }

  script(src='/js/table-sort.js', defer)

block body
  - function msToMinutesAndSeconds(ms) { const s = parseInt((ms/1000)%60); const m = parseInt((ms/(1000*60))%60); return m+":"+s; }
  
  h1 High Score

  h2 Sort by clicking the headings

  .costum-table-dark
    table.table(data-sortable)
      thead
        tr
          th(width='2%')
            button.table-sort-button(type='button') No
          th
            button.table-sort-button(type='button') Username
          th
            button.table-sort-button(type='button') Points
          th
            button.table-sort-button(type='button') Won/Lost
          th
            button.table-sort-button(type='button') Longest game
      - for (let i=0; i<highscores.length; i++)

        - const points = highscores[i].points_bw;
        - let img;
        if points < 900
          - img = "crown0.png";
        else if points >= 900 && points < 1300
          - img = "crown1.png";
        else if points >= 1300 && points < 1500
          - img = "crown2.png";
        else if points >= 1500 && points < 1700
          - img = "crown3.png";
        else if points >= 1700 && points < 1900
          - img = "crown4.png";
        else if points >= 1900 && points < 2100
          - img = "crown5.png";
        else if points >= 2100 && points < 2300
          - img = "crown6.png";
        else if points >= 2300 && points < 2500
          - img = "crown7.png";
        else if points >= 2500 && points < 2700
          - img = "crown8.png";
        else if points >= 2700 && points < 2900
          - img = "crown9.png";
        else
          - img = "crown10.png";
        tr
          td
            | #{i+1}
          td
            a(href='https://mongot.com/user/' + highscores[i].username ) #{highscores[i].username}
          td
            img(src="/img/rankings/" + img)
            |  #{highscores[i].points_bw}
          td
            | #{highscores[i].games_won_bw} / #{highscores[i].games_lost_bw}
          td
            | #{msToMinutesAndSeconds(highscores[i].game_length_bw)}
