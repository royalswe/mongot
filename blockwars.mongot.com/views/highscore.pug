extends base
block head
  - const title = 'High score'

block pageStyles
  link(rel='stylesheet', href='/css/pages.css?v=4')

  script(src='/js/table-sort.js', defer)

block body
  - function msToMinutesAndSeconds(ms) { const totalSeconds = Math.floor(ms / 1000); return `${Math.floor(totalSeconds / 60)}:${String(totalSeconds % 60).padStart(2, '0')}`; }

  main.page-shell.records-page
    .records-heading
      header.page-heading
        p.page-kicker Competitive standings
        h1 High scores
        p.page-intro Rankings are based on points earned in ranked games.
      a.action-link(href='/lobby')
        i.fa.fa-play(aria-hidden='true')
        | Find a game

    .table-surface
      .table-scroll
        table.records-table(data-sortable)
          caption.visually-hidden Blockwars player rankings
          thead
            tr
              th(scope='col')
                button.table-sort-button(type='button') Rank
              th(scope='col')
                button.table-sort-button(type='button') Player
              th(scope='col', aria-sort='descending')
                button.table-sort-button(type='button') Points
              th(scope='col')
                button.table-sort-button(type='button') Won / lost
              th(scope='col')
                button.table-sort-button(type='button') Longest game
          tbody
            if highscores.length === 0
              tr
                td.empty-state(colspan='5') No ranked games yet. Join a room and set the first score.
            - for (let i=0; i<highscores.length; i++)
              if highscores.length > 0
              - const points = highscores[i].points_bw;
              - let img;
              if points < 900
                - img = "crown0.png";
              else if points < 1300
                - img = "crown1.png";
              else if points < 1500
                - img = "crown2.png";
              else if points < 1700
                - img = "crown3.png";
              else if points < 1900
                - img = "crown4.png";
              else if points < 2100
                - img = "crown5.png";
              else if points < 2300
                - img = "crown6.png";
              else if points < 2500
                - img = "crown7.png";
              else if points < 2700
                - img = "crown8.png";
              else if points < 2900
                - img = "crown9.png";
              else
                - img = "crown10.png";
              tr
                td #{i+1}
                td
                  a(href='https://mongot.com/user/' + highscores[i].username) #{highscores[i].username}
                td
                  img(src="/img/rankings/" + img, alt='')
                  |  #{highscores[i].points_bw}
                td #{highscores[i].games_won_bw} / #{highscores[i].games_lost_bw}
                td #{msToMinutesAndSeconds(highscores[i].game_length_bw)}
