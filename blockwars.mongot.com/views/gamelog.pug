extends base
block head
  - const title = 'Game log'
    style.
      body {
        background-color: #E0E0E0;
      }
      .costum-table-dark .table th {
        padding: 15px 10px !important;
        background-color: #212121;
        color: #EC7149;
        border-top: 0 !important;
        border-bottom: 2px solid #505050 !important;
      }
      .costum-table-dark .table tr:hover {
        background-color: #3A3A3A;
      }
      .costum-table-dark {
        background: #434242;
        color: #FFF;
        width: 99%;
        margin-left: auto;
        margin-right: auto;
        margin-bottom: 20px;
      }
      tr:nth-child(even) {
        background: #666666;
      }
      td{
        padding-left: 5px;
      }
      td a{
        color: #ffffff;
        text-decoration: none;
      }
      th {
        border-top: 1px solid #505050;
        text-align: left;
        cursor: ns-resize;
      }
      .table-sort-button {
        padding: 0;
        border: 0;
        background: transparent;
        color: inherit;
        font: inherit;
        text-align: left;
        cursor: pointer;
      }
      th[aria-sort="ascending"] .table-sort-button::after {
        content: " \\25B2";
      }
      th[aria-sort="descending"] .table-sort-button::after {
        content: " \\25BC";
      }
      h2{
        text-align: center;
      }

  script(src='/js/table-sort.js', defer)

block body
  
  h2 Sort by clicking the headings

  .costum-table-dark
    table.table(data-sortable)
      thead
        tr
          th(width='2%')
            button.table-sort-button(type='button') No
          th
            button.table-sort-button(type='button') Game Time
          th
            button.table-sort-button(type='button') winner
          th
            button.table-sort-button(type='button') Players and points
          th
            button.table-sort-button(type='button') Date
      - for (let i=0; i<logs.length; i++)

        tr
          td
            | #{i+1}
          td
            | #{logs[i].game_time}
          td
            | #{logs[i].winner}
          td
            | #{logs[i].players.split('"').join(' ')}
          td
            | #{logs[i].createdAt.toJSON().substr(0, 16).split('T').join(' ')}
