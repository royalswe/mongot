extends base
block head
  - const title = 'Game log'

block pageStyles
  link(rel='stylesheet', href='/css/pages.css?v=4')

  script(src='/js/table-sort.js', defer)

block body
  - function msToMinutesAndSeconds(ms) { const totalSeconds = Math.floor(ms / 1000); return `${Math.floor(totalSeconds / 60)}:${String(totalSeconds % 60).padStart(2, '0')}`; }
  main.page-shell.records-page
    header.page-heading
      p.page-kicker Room history
      h1 Game log
      p.page-intro Review completed games, their winners, and player point changes.

    .table-surface
      .table-scroll
        table.records-table(data-sortable)
          caption.visually-hidden Completed Blockwars games
          thead
            tr
              th(scope='col')
                button.table-sort-button(type='button') No.
              th(scope='col')
                button.table-sort-button(type='button') Game time
              th(scope='col')
                button.table-sort-button(type='button') Winner
              th(scope='col')
                button.table-sort-button(type='button') Players and points
              th(scope='col')
                button.table-sort-button(type='button') Date
          tbody
            if logs.length === 0
              tr
                td.empty-state(colspan='5') No completed games yet.
            - for (let i=0; i<logs.length; i++)
              tr
                td #{i+1}
                td #{msToMinutesAndSeconds(logs[i].game_time)}
                td #{logs[i].winner}
                td #{logs[i].players.split('"').join(' ')}
                td #{logs[i].createdAt.toJSON().substr(0, 16).split('T').join(' ')}
