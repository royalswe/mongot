extends base
block head
  - const title = 'Blockwars'

block pageStyles
  link(rel='stylesheet', href='/css/pages.css?v=4')

block body
  main.page-shell.home-page
    section.hero
      .hero-copy
        p.page-kicker Multiplayer block battles
        h1 Blockwars
        p.hero-tagline Stack falling blocks, clear rows and send Specials to outlast up to four opponents. Jump into an open room and play as a guest.
        .hero-actions
          a.action-link(href='/lobby')
            i.fa.fa-play(aria-hidden='true')
            | Join a game
          a.action-link.secondary(href='/rules')
            i.fa.fa-book(aria-hidden='true')
            | Read the rules
        p.hero-note Ranked rooms and points are available to registered players.
      .hero-board
        img(src='/img/hero-board.svg', width='760', height='480', alt='Five Blockwars Arenas side by side, with your Arena in the center and a Tetris piece falling')
        span.sticker New themes

    section.features(aria-label='Explore Blockwars')
      a.feature(href='/lobby')
        i.feature-icon.fa.fa-globe(aria-hidden='true')
        h2 Lobby
        p Join an open room or watch a game. Guests play unranked; register to earn rank.
      a.feature(href='/highscore')
        i.feature-icon.fa.fa-trophy(aria-hidden='true')
        h2 High Score
        p See which players have the best rank in Blockwars.
      a.feature(href='/rules')
        i.feature-icon.fa.fa-book(aria-hidden='true')
        h2 How to play
        p First time playing? Learn the controls and the twelve Specials.